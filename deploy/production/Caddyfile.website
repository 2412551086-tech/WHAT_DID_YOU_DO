# Enable only after website/build.mjs succeeds without --preview and DNS/TLS are verified.
douxiaolang.com {
    root * /srv/familyguard-site
    encode zstd gzip
    try_files {path} {path}.html
    file_server
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
        -Server
    }
}
