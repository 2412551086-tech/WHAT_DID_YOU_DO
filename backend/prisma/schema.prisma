generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Chore {
  id                   String   @id @default(cuid())
  name                 String   @unique
  category             String
  standardMinutes      Int
  difficultyMultiplier Float
  defaultPoints        Int
  icon                 String
  isFreeCore           Boolean  @default(true)
  sortOrder            Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isFreeCore, sortOrder])
}
